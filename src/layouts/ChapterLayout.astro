---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { chapters, neighbors, phases } from "../data/book";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const chapter = chapters.find((item) => item.slug === slug);
if (!chapter) throw new Error(`Unknown chapter ${slug}`);
const { prev, next } = neighbors(slug);
const phase = phases[chapter.phase];
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${chapter.title} · The Harness Era`} description={chapter.subtitle}>
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-5 pb-16 pt-10">
    <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.22em] text-copper-deep">
      {phase.kicker} · Chapter {String(chapter.order).padStart(2, "0")} of 09 · {chapter.era}
    </p>
    <h1 class="mt-2 font-display text-4xl leading-tight text-ink sm:text-5xl">{chapter.title}</h1>
    <p class="mt-3 font-serif text-xl italic text-ink-soft">{chapter.subtitle}</p>
    <dl class="mt-6 grid gap-3 rounded-2xl border border-rule bg-paper-3 p-4 sm:grid-cols-2">
      <div>
        <dt class="font-sans text-[11px] uppercase tracking-[0.16em] text-ink-soft">Focus</dt>
        <dd class="mt-1 text-ink">{chapter.focus}</dd>
      </div>
      <div>
        <dt class="font-sans text-[11px] uppercase tracking-[0.16em] text-ink-soft">Core problem</dt>
        <dd class="mt-1 text-ink">{chapter.problem}</dd>
      </div>
    </dl>
    <article class="prose-book mt-8">
      <slot />
    </article>
    <nav class="mt-14 grid gap-3 sm:grid-cols-2">
      {
        prev ? (
          <a href={`${base}chapters/${prev.slug}`} class="rounded-2xl border border-rule bg-paper-3 p-4 no-underline hover:border-copper">
            <span class="block font-sans text-[11px] uppercase tracking-[0.16em] text-ink-soft">Previous</span>
            <span class="mt-1 block font-display text-xl text-ink">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`${base}chapters/${next.slug}`} class="rounded-2xl border border-rule bg-ink p-4 no-underline hover:bg-copper-deep">
            <span class="block font-sans text-[11px] uppercase tracking-[0.16em] text-paper-2">Next</span>
            <span class="mt-1 block font-display text-xl text-paper">{next.title}</span>
          </a>
        ) : (
          <a href={base} class="rounded-2xl border border-rule bg-ink p-4 no-underline">
            <span class="block font-sans text-[11px] uppercase tracking-[0.16em] text-paper-2">End</span>
            <span class="mt-1 block font-display text-xl text-paper">Back to contents</span>
          </a>
        )
      }
    </nav>
  </main>
  <SiteFooter />
</BaseLayout>
